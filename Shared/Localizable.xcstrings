    "small 크기에서 보여 줄 계정. 비우면 첫 번째 계정.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account shown in the small size. Leave empty for the first account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小サイズで表示するアカウント。空欄なら最初のアカウント。"
          }
        }
      }
    },
