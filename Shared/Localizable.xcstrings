        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をダウンロード中…"
          }
        }
      }
    },
    "%@ 로그인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にログイン"
          }
        }
