            "value": "Label"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベル"
          }
        }
      }
    },
    "로그인 시 실행": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        }
      }
    },
    "로그인…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン…"
          }
        }
      }
    },
    "로그인이 필요합니다 — ‘로그인’ 을 누르면 이후 앱이 스스로 갱신합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in needed — press “Sign in” once and the app keeps the session alive from then on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインが必要です — 「ログイン」を押せば以後はアプリが自動で更新します"
          }
        }
      }
    },
    "리셋까지 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets in %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットまで %@"
          }
        }
      }
    },
    "릴리즈 페이지 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Release Page"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリースページを開く"
          }
        }
      }
    },
    "마지막 갱신 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last updated %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終更新 %@"
          }
        }
      }
    },
    "버전 %@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@ (%@)"
          }
        }
      }
    },
    "복사": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー"
          }
        }
      }
    },
    "브라우저 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open browser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザを開く"
          }
        }
      }
    },
    "브라우저에서 이 계정(%@)으로 로그인하면 코드가 표시됩니다. 그 코드를 아래에 붙여 넣으세요. 한 번 로그인하면 앱이 스스로 토큰을 갱신합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to this account (%@) in the browser and it will show a code. Paste that code below. After one sign-in the app refreshes the token on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでこのアカウント（%@）にログインするとコードが表示されます。そのコードを下に貼り付けてください。一度ログインすればアプリがトークンを自動で更新します。"
          }
        }
      }
    },
    "새 버전이 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version is available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがあります"
          }
        }
      }
    },
    "새로고침": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        }
      }
    },
    "서버 응답 %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server replied %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー応答 %lld"
          }
        }
